+
+      // ---- Skill Tree Loadouts: preset bar ----
+      // One button per preset under the equipped skills: click = OnStlPresetLoad(idx),
+      // hold STL_HOLD_MS = OnStlPresetSave(idx); then Reset (OnStlReset) and Undo (OnStlUndo).
+      // The script answers with "character.stl.presets" and "character.stl.actions".
+
+      private function stlButtonWidth(idx:int) : Number
+      {
+         return idx < this.STL_COUNT ? this.STL_PRESET_W : this.STL_ACTION_W;
+      }
+
+      private function stlCreateBar() : void
+      {
+         var i:int = 0;
+         var posX:Number = 0;
+         var btn:Sprite = null;
+         var label:TextField = null;
+         var fmt:TextFormat = this.txfAvailablePoints.getTextFormat();
+         fmt.size = this.STL_FONT_SIZE;
+         fmt.align = TextFormatAlign.CENTER;
+         this._stlBar = new Sprite();
+         for(i = 0; i <= this.STL_UNDO; i++)
+         {
+            if(i == this.STL_RESET)
+            {
+               posX += this.STL_GROUP_GAP - this.STL_BTN_GAP;
+            }
+            btn = new Sprite();
+            btn.name = "stlButton" + i;
+            btn.x = posX;
+            posX += this.stlButtonWidth(i) + this.STL_BTN_GAP;
+            btn.buttonMode = true;
+            btn.mouseChildren = false;
+            label = new TextField();
+            label.embedFonts = this.txfAvailablePoints.embedFonts;
+            label.defaultTextFormat = fmt;
+            label.selectable = false;
+            label.mouseEnabled = false;
+            label.x = 4;
+            label.width = this.stlButtonWidth(i) - 8;
+            label.height = 30;
+            label.y = (this.STL_BTN_H - label.height) / 2;
+            btn.addChild(label);
+            btn.addEventListener(MouseEvent.MOUSE_DOWN,this.stlOnMouseDown,false,0,true);
+            btn.addEventListener(MouseEvent.ROLL_OVER,this.stlOnRollOver,false,0,true);
+            btn.addEventListener(MouseEvent.ROLL_OUT,this.stlOnRollOut,false,0,true);
+            this._stlBar.addChild(btn);
+            this._stlButtons.push(btn);
+            this._stlLabels.push(label);
+         }
+         addChild(this._stlBar);
+         this._stlPagesBar = new Sprite();
+         this._stlPagesBar.visible = false;
+         addChild(this._stlPagesBar);
+         this.stlLayout();
+         this.stlRedrawAll();
+      }
+
+      // Centred under the slot grid in use, on the "available points" line, or just below the
+      // grid when a mutation is equipped (its extra row goes lower), never past the help bar.
+      // The grid is the active container: the module's own bounds also count the hidden one.
+      private function stlLayout() : void
+      {
+         var grid:MovieClip = this.moduleSkillSlot.mutationMode ? this.moduleSkillSlot.mcSlotsMutation : this.moduleSkillSlot.mcSlotsNormal;
+         var slots:Rectangle = (grid ? grid : this.moduleSkillSlot).getBounds(this);
+         var last:Sprite = this._stlButtons[this.STL_UNDO] as Sprite;
+         var total:Number = last.x + this.STL_ACTION_W;
+         var barY:Number = this.txfAvailablePoints.y + (this.txfAvailablePoints.height - this.STL_BTN_H) / 2;
+         barY = Math.max(barY,slots.y + slots.height + this.STL_GRID_GAP);
+         barY = Math.min(barY,this.STL_BOTTOM_LIMIT - this.STL_BTN_H);
+         this._stlBar.x = Math.round(slots.x + (slots.width - total) / 2);
+         this._stlBar.y = Math.round(barY);
+         this.stlLayoutPages(slots);
+      }
+
+      public function stlSetPresets(value:Array) : void
+      {
+         this._stlData = value ? value : [];
+         this.stlRedrawAll();
+      }
+
+      public function stlSetActions(value:Array) : void
+      {
+         this._stlActions = value ? value : [];
+         this.stlRedrawAll();
+      }
+
+      // ---- Skill Tree Loadouts: slot pages (Pages edition) ----
+      // "character.stl.pages" = { count, current }: one button per page, click =
+      // OnStlPageSelect(page); the script then sends the slots of that page. No buttons when
+      // count < 2 (normal edition).
+
+      public function stlSetPages(value:Object) : void
+      {
+         var count:int = Boolean(value) ? int(value.count) : 0;
+         var i:int = 0;
+         var btn:Sprite = null;
+         var label:TextField = null;
+         var fmt:TextFormat = null;
+         this._stlPage = Boolean(value) ? int(value.current) : 1;
+         if(count != this._stlPageCount)
+         {
+            this._stlPageCount = count;
+            while(this._stlPagesBar.numChildren > 0)
+            {
+               this._stlPagesBar.removeChildAt(0);
+            }
+            this._stlPageButtons = [];
+            this._stlPageLabels = [];
+            fmt = this.txfAvailablePoints.getTextFormat();
+            fmt.size = this.STL_FONT_SIZE;
+            fmt.align = TextFormatAlign.CENTER;
+            for(i = 0; i < count && count > 1; i++)
+            {
+               btn = new Sprite();
+               btn.name = "stlPage" + (i + 1);
+               btn.x = i * (this.STL_PAGE_W + this.STL_BTN_GAP);
+               btn.buttonMode = true;
+               btn.mouseChildren = false;
+               label = new TextField();
+               label.embedFonts = this.txfAvailablePoints.embedFonts;
+               label.defaultTextFormat = fmt;
+               label.selectable = false;
+               label.mouseEnabled = false;
+               label.width = this.STL_PAGE_W;
+               label.height = 30;
+               label.y = (this.STL_PAGE_H - label.height) / 2;
+               label.text = String(i + 1);
+               btn.addChild(label);
+               // on press, like the preset buttons
+               btn.addEventListener(MouseEvent.MOUSE_DOWN,this.stlOnPageClick,false,0,true);
+               btn.addEventListener(MouseEvent.ROLL_OVER,this.stlOnPageRollOver,false,0,true);
+               btn.addEventListener(MouseEvent.ROLL_OUT,this.stlOnPageRollOut,false,0,true);
+               this._stlPagesBar.addChild(btn);
+               this._stlPageButtons.push(btn);
+               this._stlPageLabels.push(label);
+            }
+         }
+         this._stlPagesBar.visible = this._stlPageCount > 1 && this._stlBar.visible;
+         this.stlLayout();
+         this.stlRedrawPages();
+      }
+
+      // centred above the slot grid in use, or under the preset bar when there is no room
+      private function stlLayoutPages(slots:Rectangle) : void
+      {
+         var total:Number = 0;
+         var rowY:Number = 0;
+         if(!this._stlPagesBar || this._stlPageButtons.length == 0)
+         {
+            return;
+         }
+         total = this._stlPageButtons.length * (this.STL_PAGE_W + this.STL_BTN_GAP) - this.STL_BTN_GAP;
+         rowY = slots.y - this.STL_GRID_GAP - this.STL_PAGE_H;
+         if(rowY < this.STL_TOP_LIMIT)
+         {
+            rowY = this._stlBar.y + this.STL_BTN_H + this.STL_GRID_GAP;
+         }
+         this._stlPagesBar.x = Math.round(slots.x + (slots.width - total) / 2);
+         this._stlPagesBar.y = Math.round(rowY);
+      }
+
+      private function stlRedrawPages() : void
+      {
+         var i:int = 0;
+         var btn:Sprite = null;
+         var label:TextField = null;
+         var active:Boolean = false;
+         var hover:Boolean = false;
+         for(i = 0; i < this._stlPageButtons.length; i++)
+         {
+            btn = this._stlPageButtons[i] as Sprite;
+            label = this._stlPageLabels[i] as TextField;
+            active = i + 1 == this._stlPage;
+            hover = i == this._stlPageHover;
+            btn.graphics.clear();
+            btn.graphics.lineStyle(active ? 2 : 1,active ? 0xD9B45A : (hover ? 0xBFA36A : 0x6B5F48),1);
+            btn.graphics.beginFill(hover ? 0x2A241A : 0x000000,hover ? 0.8 : 0.55);
+            btn.graphics.drawRect(0,0,this.STL_PAGE_W,this.STL_PAGE_H);
+            btn.graphics.endFill();
+            label.textColor = active ? 0xFFFFFF : 0xB4B4B4;
+         }
+      }
+
+      private function stlOnPageClick(event:MouseEvent) : void
+      {
+         var idx:int = this._stlPageButtons.indexOf(event.currentTarget);
+         var eventEx:MouseEventEx = event as MouseEventEx;
+         if(Boolean(eventEx) && eventEx.buttonIdx == MouseEventEx.RIGHT_BUTTON)
+         {
+            return;
+         }
+         if(idx >= 0 && idx + 1 != this._stlPage && this._stlRenameIdx < 0)
+         {
+            // int(): a computed value reaches the script as a float, read there as int bits
+            dispatchEvent(new GameEvent(GameEvent.CALL,"OnStlPageSelect",[int(idx + 1)]));
+         }
+      }
+
+      private function stlOnPageRollOver(event:MouseEvent) : void
+      {
+         this._stlPageHover = this._stlPageButtons.indexOf(event.currentTarget);
+         this.stlRedrawPages();
+      }
+
+      private function stlOnPageRollOut(event:MouseEvent) : void
+      {
+         this._stlPageHover = -1;
+         this.stlRedrawPages();
+      }
+
+      private function stlRedrawAll() : void
+      {
+         var i:int = 0;
+         this.stlLayout();
+         for(i = 0; i < this._stlButtons.length; i++)
+         {
+            this.stlRedraw(i);
+         }
+      }
+
+      private function stlRedraw(idx:int) : void
+      {
+         var btn:Sprite = this._stlButtons[idx] as Sprite;
+         var label:TextField = this._stlLabels[idx] as TextField;
+         var isPreset:Boolean = idx < this.STL_COUNT;
+         var actionIdx:int = idx - this.STL_RESET;
+         var data:Object = null;
+         var lit:Boolean = false;
+         var active:Boolean = false;
+         var hover:Boolean = this._stlHover == idx;
+         var progress:Number = 0;
+         var btnW:Number = this.stlButtonWidth(idx);
+         var border:uint = 0;
+         if(isPreset)
+         {
+            data = idx < this._stlData.length ? this._stlData[idx] : null;
+            lit = Boolean(data) && Boolean(data.used);
+            active = Boolean(data) && Boolean(data.active);
+         }
+         else
+         {
+            data = actionIdx < this._stlActions.length ? this._stlActions[actionIdx] : null;
+            lit = Boolean(data) && Boolean(data.enabled);
+         }
+         border = active ? 0xD9B45A : (hover ? 0xBFA36A : 0x6B5F48);
+         if(idx == this._stlRenameIdx)
+         {
+            border = 0xFFFFFF;
+         }
+         if(isPreset && this._stlHoldIdx == idx && !this._stlHoldSaved)
+         {
+            progress = Math.min(1,(getTimer() - this._stlHoldStart) / this.STL_HOLD_MS);
+         }
+         btn.graphics.clear();
+         btn.graphics.lineStyle(active ? 2 : 1,border,1);
+         btn.graphics.beginFill(hover ? 0x2A241A : 0x000000,hover ? 0.8 : 0.55);
+         btn.graphics.drawRect(0,0,btnW,this.STL_BTN_H);
+         btn.graphics.endFill();
+         if(progress > 0)
+         {
+            btn.graphics.lineStyle();
+            btn.graphics.beginFill(0xD9B45A,0.45);
+            btn.graphics.drawRect(1,1,(btnW - 2) * progress,this.STL_BTN_H - 2);
+            btn.graphics.endFill();
+         }
+         label.text = data ? String(data.name) : "";
+         label.textColor = lit ? 0xFFFFFF : 0x8C8C8C;
+         if(idx == this._stlRenameIdx)
+         {
+            label.text = this._stlRenameText + "_";
+            label.textColor = 0xFFFFFF;
+         }
+         this.stlFitLabel(label);
+      }
+
+      // long translations or names: shrink the font until the text fits the button
+      private function stlFitLabel(label:TextField) : void
+      {
+         var fmt:TextFormat = label.getTextFormat();
+         var size:int = this.STL_FONT_SIZE;
+         fmt.size = size;
+         label.setTextFormat(fmt);
+         while(label.textWidth > label.width - 6 && size > this.STL_FONT_MIN)
+         {
+            size--;
+            fmt.size = size;
+            label.setTextFormat(fmt);
+         }
+      }
+
+      private function stlIndexOf(target:Object) : int
+      {
+         return this._stlButtons.indexOf(target);
+      }
+
+      private function stlOnRollOver(event:MouseEvent) : void
+      {
+         this._stlHover = this.stlIndexOf(event.currentTarget);
+         this.stlRedrawAll();
+      }
+
+      private function stlOnRollOut(event:MouseEvent) : void
+      {
+         this._stlHover = -1;
+         this.stlRedrawAll();
+      }
+
+      private function stlOnMouseDown(event:MouseEvent) : void
+      {
+         var idx:int = this.stlIndexOf(event.currentTarget);
+         var eventEx:MouseEventEx = event as MouseEventEx;
+         if(this._stlRenameIdx >= 0)
+         {
+            // a click on another button ends the rename (keeps the name); on the same one, nothing
+            if(idx != this._stlRenameIdx)
+            {
+               this.stlEndRename(true);
+            }
+            return;
+         }
+         if(Boolean(eventEx) && eventEx.buttonIdx == MouseEventEx.RIGHT_BUTTON)
+         {
+            if(idx < this.STL_COUNT)
+            {
+               this.stlStartRename(idx);
+            }
+            return;
+         }
+         this._stlHoldIdx = idx;
+         this._stlHoldStart = getTimer();
+         this._stlHoldSaved = false;
+         stage.addEventListener(MouseEvent.MOUSE_UP,this.stlOnMouseUp,false,0,true);
+         addEventListener(Event.ENTER_FRAME,this.stlOnHoldFrame,false,0,true);
+      }
+
+      private function stlOnHoldFrame(event:Event) : void
+      {
+         if(this._stlHoldIdx < 0)
+         {
+            return;
+         }
+         if(this._stlHoldIdx < this.STL_COUNT && !this._stlHoldSaved && getTimer() - this._stlHoldStart >= this.STL_HOLD_MS)
+         {
+            this._stlHoldSaved = true;
+            dispatchEvent(new GameEvent(GameEvent.CALL,"OnStlPresetSave",[this._stlHoldIdx]));
+         }
+         this.stlRedraw(this._stlHoldIdx);
+      }
+
+      // released over the same button before the hold time: click; after a save, nothing more
+      private function stlOnMouseUp(event:MouseEvent) : void
+      {
+         var idx:int = this._stlHoldIdx;
+         stage.removeEventListener(MouseEvent.MOUSE_UP,this.stlOnMouseUp);
+         removeEventListener(Event.ENTER_FRAME,this.stlOnHoldFrame);
+         this._stlHoldIdx = -1;
+         if(idx >= 0 && !this._stlHoldSaved && this._stlHover == idx)
+         {
+            if(idx == this.STL_RESET)
+            {
+               dispatchEvent(new GameEvent(GameEvent.CALL,"OnStlReset",[]));
+            }
+            else if(idx == this.STL_UNDO)
+            {
+               dispatchEvent(new GameEvent(GameEvent.CALL,"OnStlUndo",[]));
+            }
+            else
+            {
+               dispatchEvent(new GameEvent(GameEvent.CALL,"OnStlPresetLoad",[idx]));
+            }
+         }
+         if(idx >= 0)
+         {
+            this.stlRedraw(idx);
+         }
+      }
       
+      // Right click on a preset: type its name in the button. The game only passes key codes to
+      // the movie, so the text is built here from them (letters, digits, space, '-').
+      // Enter or a click elsewhere keeps it (OnStlRename), Escape cancels. The script blocks the
+      // menu hotkeys and navigation while OnStlRenaming(true) is on.
+      private function stlStartRename(idx:int) : void
+      {
+         var data:Object = idx < this._stlData.length ? this._stlData[idx] : null;
+         this._stlRenameIdx = idx;
+         this._stlRenameText = Boolean(data) && Boolean(data.used) ? String(data.name).substr(0,this.STL_NAME_MAX) : "";
+         InputDelegate.getInstance().addEventListener(InputEvent.INPUT,this.stlOnRenameInput,false,5000,true);
+         stage.addEventListener(MouseEvent.MOUSE_DOWN,this.stlOnRenameStageDown,false,0,true);
+         dispatchEvent(new GameEvent(GameEvent.CALL,"OnStlRenaming",[true]));
+         this.stlRedraw(idx);
+      }
+
+      private function stlEndRename(keep:Boolean) : void
+      {
+         var idx:int = this._stlRenameIdx;
+         if(idx < 0)
+         {
+            return;
+         }
+         this._stlRenameIdx = -1;
+         InputDelegate.getInstance().removeEventListener(InputEvent.INPUT,this.stlOnRenameInput);
+         stage.removeEventListener(MouseEvent.MOUSE_DOWN,this.stlOnRenameStageDown);
